# Rust
/target
**/*.rs.bk
Cargo.lock.orig

# macOS
.DS_Store

# Large baked assets (regenerable via data-pipeline / batch)
/crates/app-interactive/assets/processed/

# Raw data snapshots are large and regenerable (fetched via the documented
# curl/DuckDB/Overpass steps); never commit them.
/data/snapshots/

# Derived pipeline outputs (exposure batches, .ossub, result tables) — large
# and regenerable via data-pipeline / batch / the analysis scripts.
/data/derived/

# Rendered reel output (video/frames) — large, regenerable via tools/reels.
/tools/reels/out/

# marimo notebook cache/exports.
/notebooks/__marimo__/

# The FAccT'27 paper lives in its own repo (pendulating/facct27_...); it is
# checked out here for convenience but must not be embedded as a gitlink.
/facct27_digital_eyes_on_the_street/

# Python virtualenv for the OSMnx export step
/.venv
__pycache__/

# Web build output
#   web/dist/ IS committed: GitHub Pages deploys the prebuilt bundle as-is
#   (the WASM build + the gitignored baked assets can't be reproduced in CI).
#   Rebuild with ./web/build.sh and commit before pushing — see
#   .github/workflows/deploy.yml.
/web/node_modules

# Agent/editor tooling — installed skills + local Claude Code config, not
# part of the our·space project source.
/.agents
/.claude
/skills-lock.json

# Secrets — API keys (Census, etc.). Never commit.
/.env
/.env.*

# Python analysis env (uv)
.venv/
__pycache__/
*.pyc
